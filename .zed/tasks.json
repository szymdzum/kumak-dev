[
  {
    "label": "dev: Start development server",
    "command": "deno",
    "args": ["task", "dev"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "build: Build for production",
    "command": "deno",
    "args": ["task", "build"],
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "preview: Preview production build",
    "command": "deno",
    "args": ["task", "preview"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "lint: Lint code",
    "command": "deno",
    "args": ["task", "lint"],
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "format: Format code",
    "command": "deno",
    "args": ["task", "format"],
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "check: Lint + format check",
    "command": "deno",
    "args": ["task", "check"],
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "check-all: Lint + format + astro check",
    "command": "deno",
    "args": ["task", "check-all"],
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "clean: Clean build artifacts",
    "command": "rm",
    "args": ["-rf", "dist", ".astro"],
    "use_new_terminal": true,
    "reveal": "always"
  }
]
