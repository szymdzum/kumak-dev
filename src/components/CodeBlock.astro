---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'pre'>;
---

<div data-codeblock>
  <button type="button" aria-label="Copy code to clipboard" data-codeblock-copy>
    <Icon name="lucide:copy" size={20} />
    <Icon name="lucide:check" size={20} />
  </button>
  <pre {...Astro.props}><slot /></pre>
</div>

<style>
  div {
    position: relative;
  }

  button {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0;
    background: rgb(var(--color-bg-rgb) / var(--opacity-strong));
    backdrop-filter: blur(var(--blur-sm));
    border: var(--border-width) solid rgb(var(--color-text-rgb) / var(--opacity-subtle));
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: opacity var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  [data-icon="lucide:copy"],
  [data-icon="lucide:check"] {
    color: var(--color-text-muted);
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  div:hover button,
  button:focus-visible {
    opacity: 1;
  }

  button:hover {
    background: rgb(var(--color-bg-rgb) / 0.95);
    border-color: var(--color-border);
  }

  button:hover [data-icon="lucide:copy"],
  button:hover [data-icon="lucide:check"] {
    color: var(--color-text);
  }

  button:active {
    transform: scale(0.95);
  }

  [data-icon="lucide:check"] {
    opacity: 0;
    position: absolute;
  }

  button[data-copied] [data-icon="lucide:copy"] {
    opacity: 0;
  }

  button[data-copied] [data-icon="lucide:check"] {
    opacity: 1;
  }

  button[data-copied] {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
</style>

<script>
  import { track } from "@utils/track";

  function initCopyButtons(): void {
    document.querySelectorAll<HTMLElement>('[data-codeblock]').forEach((block) => {
      const button = block.querySelector<HTMLButtonElement>('[data-codeblock-copy]');
      const pre = block.querySelector<HTMLPreElement>('pre');

      if (!button || !pre) return;

      const idleLabel = button.getAttribute('aria-label');

      button.addEventListener('click', async () => {
        const code = pre.textContent?.trim();
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = '';
          button.setAttribute('aria-label', 'Copied to clipboard');
          setTimeout(() => {
            delete button.dataset.copied;
            if (idleLabel) button.setAttribute('aria-label', idleLabel);
          }, 2000);
          track.codeCopy();
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initCopyButtons);
</script>
