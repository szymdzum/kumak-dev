---
import { siteConfig } from "@/site-config";

// A torus seen edge-on: each loop around the tube projects to an axis-aligned
// ellipse whose width shrinks as the loop turns away from the viewer.
const loopCount = 28;
const majorRadius = 115;
const tubeRadius = 44;
const cx = 250;
const cy = 110;
const tilt = Math.PI / 14;

const loops = Array.from({ length: loopCount }, (_, index) => {
  const phi = -Math.PI / 2 + (index / (loopCount - 1)) * Math.PI;
  const depth = Math.sin(phi + tilt);
  const emphasis = Math.abs(Math.cos(phi));
  return {
    cx: (cx - majorRadius * depth).toFixed(2),
    rx: (tubeRadius * Math.abs(depth)).toFixed(2),
    strokeWidth: (0.4 + emphasis * 0.55).toFixed(3),
    opacity: (0.25 + emphasis * 0.6).toFixed(3),
  };
});
---

<section>
  <svg viewBox="90 55 330 110" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g fill="none" stroke="white">
      {loops.map((loop) => (
        <ellipse
          cx={loop.cx}
          cy={cy}
          rx={loop.rx}
          ry={tubeRadius}
          stroke-width={loop.strokeWidth}
          opacity={loop.opacity}
        />
      ))}
    </g>
  </svg>
  <h1>{siteConfig.description}</h1>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h1 {
    font-family: var(--font-family-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
    letter-spacing: var(--letter-spacing-tight);
    margin-top: 0;
  }

  svg {
    width: 100%;
    height: auto;
  }
</style>
