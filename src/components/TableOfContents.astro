---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title: string;
}

const { headings, title } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2);
---

{tocHeadings.length > 0 && (
  <nav data-toc aria-label="Table of contents">
    <div>
      <h2>On this page</h2>
      <ul data-toc-list role="list">
        <li>
          <a href="#top">{title}</a>
        </li>
        {tocHeadings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  nav {
    position: absolute;
    top: 0;
    right: 0;
    transform: translateX(calc(100% + var(--space-xl)));
    width: max-content;
    height: 100%;
    font-size: var(--text-xs);
  }

  div {
    position: sticky;
    top: var(--space-xl);
  }

  h2 {
    font-family: var(--font-family-display);
    font-size: inherit;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  ul {
    position: relative;
  }

  ul::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: var(--border-width-thick);
    height: var(--toc-progress, 0%);
    background: var(--color-primary);
    z-index: 1;
    transition: height 0.15s ease-out;
  }

  li {
    padding: var(--space-3xs) 0;
    border-left: var(--border-width-thick) solid var(--color-border);
    padding-left: var(--space-sm);
  }

  li:hover {
    border-left-color: var(--color-primary);
  }

  li[data-read] {
    border-left-color: transparent;
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
    line-height: var(--line-height-snug);
    display: block;
  }

  a:hover {
    color: var(--color-primary);
  }

  li:has(a[aria-current]) {
    border-left-color: var(--color-primary);
  }

  a[aria-current] {
    color: var(--color-primary);
  }

  @media (max-width: 1320px) {
    nav {
      display: none;
    }
  }
</style>

<script src="../utils/toc.ts"></script>
