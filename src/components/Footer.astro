---
import { siteConfig } from "@/site-config";
import { i18n, localePath } from "@/i18n/ui";

const { locale, t } = i18n(Astro.currentLocale);

const currentYear = new Date().getFullYear();
---

<footer>
  <div>
    <p>© {currentYear} <a href={localePath(locale, "/about")}>{siteConfig.author.handle}</a>. {t.builtWith}</p>
  </div>
</footer>

<style>
  footer {
    border-top: var(--border-width) solid var(--color-border);
    padding: var(--space-xl) 0;
    margin-top: var(--space-3xl);
  }

  div {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
    color: var(--color-text-muted);
    text-align: center;
  }

  p {
    margin: 0;
    font-size: var(--text-xs);
    line-height: var(--line-height-relaxed);
  }

  a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-primary-rgb) / 0.4);
  }

  a:hover {
    text-decoration-color: var(--color-primary);
  }
</style>
