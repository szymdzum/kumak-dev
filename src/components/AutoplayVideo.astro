---
// Muted video with controls that plays once when it scrolls into view.
// Stays still for readers who prefer reduced motion; the controls can always pause it.
interface Props {
  src: string;
  poster: string;
  width: number;
  height: number;
  label: string;
}

const { src, poster, width, height, label } = Astro.props;
---

<video
  data-autoplay-on-view
  controls
  muted
  playsinline
  preload="none"
  width={width}
  height={height}
  poster={poster}
  aria-label={label}
>
  <source src={src} type="video/mp4" />
</video>

<script>
  const VISIBLE_RATIO = 0.6;

  // One observer per page view, disconnected before the ClientRouter swaps pages.
  document.addEventListener('astro:page-load', () => {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay-on-view]');
    if (!videos.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        (entry.target as HTMLVideoElement).play().catch(() => {});
      }
    }, { threshold: VISIBLE_RATIO });

    videos.forEach((video) => observer.observe(video));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  });
</script>
