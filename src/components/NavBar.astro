---
import { Icon } from 'astro-icon/components';
import { siteConfig } from "@/site-config";
import { i18n, LOCALE_META, localePath, pageVersions, type Translations } from "@/i18n/ui";
import LlmsTxtIcon from "./LlmsTxtIcon.astro";

interface Props {
  /** This page in other languages; the switcher links to them and hides when there are none. */
  translations?: Translations | undefined;
}

const { translations = {} } = Astro.props;
const { locale, t } = i18n(Astro.currentLocale);
const { rss, ...externalSocials } = siteConfig.socials;
const otherVersions = pageVersions(translations, locale, Astro.url.pathname).filter(([lang]) => lang !== locale);
---

<header>
  <div>
    <a href={localePath(locale, "/")} aria-label={t.home(siteConfig.name)}>[{siteConfig.name}]</a>
    {otherVersions.length > 0 && (
      <nav aria-label={t.languageSwitch}>
        {otherVersions.map(([lang, path]) => (
          <a href={path} hreflang={lang} lang={lang} aria-label={`${lang.toUpperCase()} ${LOCALE_META[lang].name}`}>
            {lang.toUpperCase()}
          </a>
        ))}
      </nav>
    )}
    <nav aria-label={t.socialLinks}>
      {Object.entries(externalSocials).map(([key, social]) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.profileOn(siteConfig.author.handle, social.name)}
          data-social={key}
        >
          <Icon name={`lucide:${key}`} size={24} />
        </a>
      ))}
      <a href={localePath(locale, rss.url)} aria-label={t.subscribeVia(rss.name)} data-astro-prefetch="false">
        <Icon name="lucide:rss" size={24} />
      </a>
      <a href="/llms-full.txt" aria-label={t.llmsFull} data-astro-prefetch="false">
        <LlmsTxtIcon />
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    padding: var(--space-md) 0;
  }

  div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Small: the logo's auto margin already spaces it from the navs; this is the language-to-social gap. */
    gap: var(--space-xs);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* The logo takes the free space, so the language and social navs sit together on the right. */
  header > div > a {
    margin-right: auto;
    font-family: var(--font-family-display);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    letter-spacing: var(--letter-spacing-tight);
  }

  /* Padding grows each icon's tap target; the negative margin keeps the last icon on the edge. */
  nav {
    --icon-pad: calc(var(--space-xs) * 0.5);
    display: flex;
    margin-right: calc(-1 * var(--icon-pad));
  }

  nav a {
    display: block;
    padding: var(--icon-pad);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  nav a:hover {
    color: var(--color-primary);
  }

  nav a[hreflang] {
    align-self: center;
    font-family: var(--font-family-display);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    header > div > a {
      font-size: var(--text-base);
    }

    nav {
      --icon-pad: var(--space-2xs);
    }

    nav svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  import { track } from "@utils/track";

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-social]').forEach((link) => {
      link.addEventListener('click', () => {
        if (link.dataset.social) track.social(link.dataset.social);
      });
    });
  });
</script>
