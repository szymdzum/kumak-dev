---
import { Icon } from 'astro-icon/components';
import { siteConfig } from "@/site-config";
import LlmsTxtIcon from "./LlmsTxtIcon.astro";

const { rss, ...externalSocials } = siteConfig.socials;
---

<header>
  <div>
    <a href="/" aria-label={`${siteConfig.name} home`}>[{siteConfig.name}]</a>
    <nav aria-label="Social links">
      {Object.entries(externalSocials).map(([key, social]) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${siteConfig.author.handle} on ${social.name}`}
          data-social={key}
        >
          <Icon name={`lucide:${key}`} size={24} />
        </a>
      ))}
      <a href={rss.url} aria-label={`Subscribe via ${rss.name}`} data-astro-prefetch="false">
        <Icon name="lucide:rss" size={24} />
      </a>
      <a href="/llms-full.txt" aria-label="LLMs.txt full content" data-astro-prefetch="false">
        <LlmsTxtIcon />
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    padding: var(--space-md) 0;
  }

  div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  header > div > a {
    font-family: var(--font-family-display);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    letter-spacing: var(--letter-spacing-tight);
  }

  /* Padding grows each icon's tap target; the negative margin keeps the last icon on the edge. */
  nav {
    --icon-pad: calc(var(--space-xs) * 0.5);
    display: flex;
    margin-right: calc(-1 * var(--icon-pad));
  }

  nav a {
    display: block;
    padding: var(--icon-pad);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  nav a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 480px) {
    header > div > a {
      font-size: var(--text-base);
    }

    nav {
      --icon-pad: var(--space-2xs);
    }

    nav svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  import { track } from "@utils/track";

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-social]').forEach((link) => {
      link.addEventListener('click', () => {
        if (link.dataset.social) track.social(link.dataset.social);
      });
    });
  });
</script>
