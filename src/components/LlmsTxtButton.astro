---
import ActionButton from "./ActionButton.astro";
import LlmsTxtIcon from "./LlmsTxtIcon.astro";
import { i18n } from "@/i18n/ui";

interface Props {
  /** The post's plain-text (llms.txt) path. */
  href: string;
}

const { href } = Astro.props;
const { t } = i18n(Astro.currentLocale);
---

<ActionButton
  href={href}
  label="LLM"
  aria-label={t.llmsVersion}
  data-astro-prefetch="false"
>
  <LlmsTxtIcon size={16} />
</ActionButton>
