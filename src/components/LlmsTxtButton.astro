---
import ActionButton from "./ActionButton.astro";
import LlmsTxtIcon from "./LlmsTxtIcon.astro";
import { llmsUrl } from "@utils/path";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<ActionButton
  href={llmsUrl(slug)}
  label="LLM"
  aria-label="View LLM-friendly version"
  data-astro-prefetch="false"
>
  <LlmsTxtIcon size={16} />
</ActionButton>
