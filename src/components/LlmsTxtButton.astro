---
import ActionButton from "./ActionButton.astro";
import LlmsTxtIcon from "./LlmsTxtIcon.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<ActionButton
  href={`/llms/${slug}.txt`}
  label="LLM"
  aria-label="View LLM-friendly version"
  data-astro-prefetch="false"
>
  <LlmsTxtIcon size={16} />
</ActionButton>
