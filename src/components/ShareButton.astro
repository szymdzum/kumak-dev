---
import { Icon } from "astro-icon/components";
import ActionButton from "./ActionButton.astro";
import { i18n } from "@/i18n/ui";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "" } = Astro.props;
const { t } = i18n(Astro.currentLocale);
---

<ActionButton
  label={t.share}
  data-share
  data-title={title}
  data-description={description}
  data-copied-label={t.linkCopied}
  aria-label={t.shareArticle}
>
  <Icon name="lucide:share-2" size={16} />
</ActionButton>

<script>
  import { track } from "@utils/track";

  function initShareButton(): void {
    const button = document.querySelector<HTMLButtonElement>("[data-share]");
    const label = button?.querySelector<HTMLElement>("[data-label]");
    if (!button || !label) return;

    const { title = "", description = "", copiedLabel = "" } = button.dataset;
    const idleLabel = label.textContent;
    const url = window.location.href;

    button.addEventListener("click", async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, text: description, url });
          track.share("native");
        } catch (err) {
          const isAbort = err instanceof Error && err.name === "AbortError";
          if (!isAbort) console.error("Share failed:", err);
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = copiedLabel;
        setTimeout(() => (label.textContent = idleLabel), 2000);
        track.share("clipboard");
      } catch (err) {
        console.error("Fallback copy failed:", err);
      }
    });
  }

  document.addEventListener("astro:page-load", initShareButton);
</script>
