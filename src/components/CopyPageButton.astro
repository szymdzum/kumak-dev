---
import { Icon } from "astro-icon/components";
import ActionButton from "./ActionButton.astro";
import { llmsUrl } from "@utils/path";
import { i18n } from "@/i18n/ui";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const { t } = i18n(Astro.currentLocale);
---

<ActionButton
  label={t.copy}
  data-copy-page={llmsUrl(slug)}
  data-copied-label={t.copied}
  data-failed-label={t.copyFailed}
  aria-label={t.copyAsMarkdown}
>
  <Icon name="lucide:copy" size={16} />
  <Icon name="lucide:check" size={16} />
</ActionButton>

<script>
  import { track } from "@utils/track";

  const RESET_DELAY = 2000;

  async function fetchMarkdown(url: string): Promise<string> {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.text();
  }

  // ClipboardItem with a promise keeps the user gesture alive across the
  // fetch (required by Safari); writeText is the fallback.
  async function copyFrom(url: string): Promise<void> {
    if (typeof ClipboardItem !== "undefined" && navigator.clipboard.write) {
      const blob = fetchMarkdown(url).then((text) => new Blob([text], { type: "text/plain" }));
      await navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })]);
    } else {
      await navigator.clipboard.writeText(await fetchMarkdown(url));
    }
  }

  function initCopyPageButton() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-page]");
    const label = button?.querySelector<HTMLElement>("[data-label]");
    const url = button?.dataset.copyPage;
    if (!button || !label || !url) return;

    const idleLabel = label.textContent;
    const { copiedLabel = "", failedLabel = "" } = button.dataset;
    const reset = () => {
      delete button.dataset.copied;
      label.textContent = idleLabel;
    };

    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      clearTimeout(resetTimer);
      try {
        await copyFrom(url);
        button.dataset.copied = "";
        label.textContent = copiedLabel;
        track.articleCopy();
      } catch (err) {
        console.error("Failed to copy:", err);
        label.textContent = failedLabel;
      }
      resetTimer = setTimeout(reset, RESET_DELAY);
    });
  }

  document.addEventListener("astro:page-load", initCopyPageButton);
</script>
