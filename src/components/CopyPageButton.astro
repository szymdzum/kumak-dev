---
import { Icon } from "astro-icon/components";
import ActionButton from "./ActionButton.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<ActionButton label="Copy" data-copy-page={`/llms/${slug}.txt`} aria-label="Copy as Markdown">
  <Icon name="lucide:copy" size={16} />
  <Icon name="lucide:check" size={16} />
</ActionButton>

<script>
  const RESET_DELAY = 2000;

  async function fetchMarkdown(url: string): Promise<string> {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.text();
  }

  // ClipboardItem with a promise keeps the user gesture alive across the
  // fetch (required by Safari); writeText is the fallback.
  async function copyFrom(url: string): Promise<void> {
    if (typeof ClipboardItem !== "undefined" && navigator.clipboard.write) {
      const blob = fetchMarkdown(url).then((text) => new Blob([text], { type: "text/plain" }));
      await navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })]);
    } else {
      await navigator.clipboard.writeText(await fetchMarkdown(url));
    }
  }

  function initCopyPageButton() {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-page]");
    const label = button?.querySelector<HTMLElement>("[data-label]");
    const url = button?.dataset.copyPage;
    if (!button || !label || !url) return;

    const reset = () => {
      delete button.dataset.copied;
      label.textContent = "Copy";
    };

    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      clearTimeout(resetTimer);
      try {
        await copyFrom(url);
        button.dataset.copied = "";
        label.textContent = "Copied";
        track.articleCopy();
      } catch (err) {
        console.error("Failed to copy:", err);
        label.textContent = "Failed";
      }
      resetTimer = setTimeout(reset, RESET_DELAY);
    });
  }

  document.addEventListener("astro:page-load", initCopyPageButton);
</script>
