---
import { Font, fontData } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/site-config";
import "../styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  ogType?: "website" | "article" | undefined;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = siteConfig.image,
  ogType = "website",
} = Astro.props;
const imageURL = new URL(image, Astro.site).href;

const FONT_VARIABLES = ["--font-inter", "--font-jetbrains-mono"] as const;

// Preload only each font's latin file: the first variant (see subsetVariants in astro.config.mjs).
// The Polish subset loads on demand through its unicode-range; `<Font preload>` can't tell the
// two apart because the local provider sets no subset.
const preloadFonts = FONT_VARIABLES.map((cssVariable) => fontData[cssVariable]?.[0]?.src[0])
  .filter((src) => src !== undefined)
  .map(({ url, format = "woff2" }) => ({ href: url, type: `font/${format}` }));
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#101113" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {FONT_VARIABLES.map((cssVariable) => <Font cssVariable={cssVariable} />)}
  {preloadFonts.map(({ href, type }) => <link rel="preload" href={href} as="font" type={type} crossorigin />)}

  <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={title} />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />

  <ClientRouter />

  <slot name="head" />

  <!-- Umami Analytics -->
  <script defer src={`${siteConfig.umami.url}/script.js`} data-website-id={siteConfig.umami.websiteId}></script>
</head>
