---
import Head from "@components/Head.astro";
import NavBar from "@components/NavBar.astro";
import Footer from "@components/Footer.astro";
import "@styles/prose.css";
import type { ComponentProps } from "astro/types";
import { i18n } from "@/i18n/ui";

type Props = ComponentProps<typeof Head>;

const { locale, t } = i18n(Astro.currentLocale);
---

<!doctype html>
<html lang={locale}>
  <Head {...Astro.props}>
    <slot name="head" slot="head" />
  </Head>
  <body>
    <a href="#main" data-skip-link>{t.skipToContent}</a>
    <NavBar translations={Astro.props.translations} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    /* minmax(0, …) so a long code line can't widen the page past the viewport. */
    grid-template-columns: minmax(0, 1fr);
  }

  main {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--gutter) var(--space-xl);
    width: 100%;
  }

  main:focus {
    outline: none;
  }

  [data-skip-link] {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-bg);
    color: var(--color-primary);
    border: var(--border-width) solid var(--color-primary);
    border-radius: var(--radius-sm);
    z-index: var(--z-sticky);
    transform: translateY(-200%);
  }

  [data-skip-link]:focus {
    transform: none;
  }
</style>
